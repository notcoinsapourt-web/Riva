# Create a new token with @BotFather and never commit the real value.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_FROM_BOTFATHER
ADMIN_IDS=123456789

# SQLite (development / small installations)
DATABASE_URL=sqlite+aiosqlite:///./data/persian_shop.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/persian_shop

SHOP_NAME=Persian Shop
SUPPORT_USERNAME=
DEFAULT_LANGUAGE=fa
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# Successful-order report channel. Accepts @username, t.me link, or Bot API chat ID.
ORDER_REPORT_CHANNEL_ID=
# Optional numeric Premium Custom Emoji ID for the report CTA button.
# Individual report-text Premium Emojis can also be managed in-bot with /reportemoji.
ORDER_REPORT_BUTTON_EMOJI_ID=
# Background repair loop: retries recent orders whose channel report was missed.
ORDER_REPORT_RECONCILE_INTERVAL_SECONDS=30
ORDER_REPORT_RECONCILE_HOURS=2

# Temporary isolated report-delivery campaign for a PRIVATE test channel only.
# It never creates orders, users, payments, or wallet transactions.
REPORT_TEST_CAMPAIGN_ENABLED=false
# Numeric private channel ID when known. If blank, make the bot an admin in the
# private channel after enabling the campaign; it will bind that channel automatically.
REPORT_TEST_CAMPAIGN_CHANNEL_ID=
REPORT_TEST_CAMPAIGN_START=
REPORT_TEST_CAMPAIGN_DAYS=14
REPORT_TEST_CAMPAIGN_DAILY_COUNT=20
# Eligible products must have price strictly greater than this value.
REPORT_TEST_CAMPAIGN_MIN_PRICE=300000
REPORT_TEST_CAMPAIGN_SEED=report-test
REPORT_TEST_CAMPAIGN_POLL_SECONDS=20

# Payment code exists, but stays locked until both flags are explicitly enabled.
PAYMENTS_ENABLED=false
PAYMENT_INTEGRATION_CONFIRMED=false
PAYMENT_CALLBACK_BASE_URL=
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
IDPAY_SANDBOX=true
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Render/Railway health server
HEALTH_SERVER_ENABLED=true
PORT=10000

# Anti-spam
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=5
