# Create a new token with @BotFather and never commit the real value.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_FROM_BOTFATHER
ADMIN_IDS=123456789

# SQLite (development / small installations)
DATABASE_URL=sqlite+aiosqlite:///./data/persian_shop.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/persian_shop

SHOP_NAME=Persian Shop
SUPPORT_USERNAME=
DEFAULT_LANGUAGE=fa
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO

# Payment code exists, but stays locked until both flags are explicitly enabled.
PAYMENTS_ENABLED=false
PAYMENT_INTEGRATION_CONFIRMED=false
PAYMENT_CALLBACK_BASE_URL=
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
IDPAY_SANDBOX=true
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=

# Render/Railway health server
HEALTH_SERVER_ENABLED=true
PORT=10000

# Anti-spam
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=5
